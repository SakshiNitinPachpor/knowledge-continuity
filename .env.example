# ====================================================================
# Knowledge Continuity — Environment Configuration Template
# Tagline: Preserve Knowledge. Continue Progress.
# ====================================================================

# Application
PROJECT_NAME="Knowledge Continuity"
ORGANIZATION="Knowledge Continuity"
VERSION="1.0.0"
SECRET_KEY="replace-with-a-secure-random-secret-key-for-jwt-signing"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DEMO_OWNER_PASSWORD=""

# Database Connection
# Local Development: SQLite
DATABASE_URL="sqlite:///./knowledge_continuity.db"
# Production Deployment: PostgreSQL (Example: postgresql://user:password@localhost:5432/knowledge_continuity)
# DATABASE_URL="postgresql://user:password@db:5432/knowledge_continuity"

# AI Service Configuration
# Options: 'deterministic_grounded' (default, reproducible, 0-cost, 100% grounded), 'gemini', 'openai'
AI_PROVIDER="deterministic_grounded"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Document Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=25

# CORS Origins (Comma-separated in production)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"
